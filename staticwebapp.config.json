{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/js/*", "/config.js", "/styles.css", "/*.{png,svg,ico,webmanifest}"]
  },
  "routes": [
    {
      "route": "/api/config",
      "allowedRoles": ["anonymous"],
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      }
    },
    {
      "route": "/config.js",
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      }
    },
    {
      "route": "/js/*",
      "headers": {
        "Cache-Control": "no-cache"
      }
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "same-origin",
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
  },
  "mimeTypes": {
    ".js": "text/javascript",
    ".json": "application/json"
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html"
    }
  },
  "platform": {
    "apiRuntime": "node:20"
  }
}
